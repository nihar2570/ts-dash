# Optional CARTO Basemaps API Key
# CARTO now requires a free API key to avoid basemap watermarks.
# You can obtain a free key with up to 5,000,000 monthly requests at:
# https://carto.com/basemaps/apikey/
#
# If this variable is left unset or blank, the dashboard automatically uses
# Esri World Light Gray Canvas, which has NO watermark and requires NO API key.
VITE_CARTO_API_KEY=
